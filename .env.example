# Trash2Treasure environment variables
# Copy this file to .env.local and fill in your Supabase project values.

# Server
PORT=3001

# Supabase
# Project URL: Supabase Dashboard > Project Settings > API > Project URL.
# Vite exposes only VITE_* variables to browser code, and the backend also reads this value.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key: Supabase Dashboard > Project Settings > API > anon public.
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-only service role key: Supabase Dashboard > Project Settings > API > service_role
# Never expose this value in VITE_* variables or client-side code.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Storage bucket created by supabase/migrations/20260522000100_init_supabase_backend.sql
SUPABASE_AVATAR_BUCKET=avatars

# Google OAuth client used by the browser Google sign-in button.
VITE_GOOGLE_CLIENT_ID=886898774772-le3g05q82norpn0t7jl4o3bfvlptutgu.apps.googleusercontent.com
